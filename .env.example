# 复制成 .env 并按需修改：docker compose 会自动读取同目录下的 .env
PORT=8080
# 留空 = 不启用 Basic Auth。不要在公网这么干（详见 README「安全须知」）。
WEB_PASSWORD=
# 例如 Asia/Shanghai —— 所有 cron 表达式按这个时区解释。改了要 `docker compose up -d` 重建。
TZ=UTC
# 容器以这个 uid/gid 运行，需要能写 ./data。留默认或改成你自己的（id -u / id -g）。
APP_UID=10001
APP_GID=10001
# 构建镜像时用的国内源（只在 `docker compose build` 时生效）。海外/CI 改成官方源：
#   APT_MIRROR=              （空 = 用 Debian 官方源）
#   PIP_INDEX_URL=https://pypi.org/simple
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
